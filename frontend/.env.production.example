# Variables de entorno para PRODUCCIÓN del frontend.
# Este archivo es solo de referencia: en Vercel estas variables se cargan
# desde el dashboard (Project Settings → Environment Variables), NO desde
# un archivo .env subido al repo. Si despliegas el frontend en otro sitio
# con soporte de archivos .env, copia esto como .env.production.local.

NEXT_PUBLIC_API_URL=https://api.tudominio.com/api
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
