# =====================================================
# PEDZIO - Variables de entorno
# Copia este archivo como ".env" y coloca tus valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.
# =====================================================

APP_NAME=Pedzio
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedzio_db
DB_USER=usuario_hosting
DB_PASS=clave_super_segura

SESSION_NAME=pedzio_session
SESSION_LIFETIME=7200

UPLOADS_MAX_MB=5

# Orígenes permitidos por CORS en producción, separados por coma (sin espacios).
# Solo se usan cuando APP_ENV=production; en local no hace falta tocarlos.
CORS_ORIGENES=https://www.tudominio.com,https://tudominio.com

# Llaves VAPID de producción (generar con: php generar-vapid-keys.php).
# Deben ser DISTINTAS a las que uses en desarrollo local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tudominio.com
